export PROJECT_ROOT="$(pwd)"
export VIRTUAL_ENV="$PROJECT_ROOT/.cache/venv"
export UV_PROJECT_ENVIRONMENT="$VIRTUAL_ENV"
export UV_PYTHON="3.13"
export PATH="$VIRTUAL_ENV/bin:$PATH"
export UV_CACHE_DIR="$PROJECT_ROOT/.cache/uv"
export RUFF_CACHE_DIR="$PROJECT_ROOT/.cache/ruff"
export MYPY_CACHE_DIR="$PROJECT_ROOT/.cache/mypy"
export PYTEST_CACHE_DIR="$PROJECT_ROOT/.cache/pytest"
export COVERAGE_FILE="$PROJECT_ROOT/.cache/coverage/.coverage"
mkdir -p "$PROJECT_ROOT/.cache/coverage"

# Git: versioned hooks + sole-contributor identity (mirrors .githooks/_policy.sh).
if git -C "$PROJECT_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
  git -C "$PROJECT_ROOT" config core.hooksPath .githooks
  git -C "$PROJECT_ROOT" config user.name "mikeZ98"
  git -C "$PROJECT_ROOT" config user.email "145975972+mikeZ98@users.noreply.github.com"
  git -C "$PROJECT_ROOT" config user.useConfigOnly true
fi
