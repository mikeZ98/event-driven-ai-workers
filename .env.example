# Copy to .env (gitignored) for `docker compose up`. Only secrets and local overrides
# belong here; non-secret defaults live in docker-compose.yml.

# Live LLM mode: requires a real API key. Leave both unset to run simulated.
# EDAW_LLM_MODE=live
# EDAW_LLM_API_KEY=

# Expose the api and worker metrics beyond loopback.
# EDAW_BIND=0.0.0.0
